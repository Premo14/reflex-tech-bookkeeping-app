# =============================================================================
# Reflex Tech Bookkeeping App — Environment Configuration
# Company: Reflex Technologies LLC (Utica, NY)
# Copy to .env and adjust values as needed. Never commit .env to version control.
# =============================================================================

# ── Database (PostgreSQL 18) ──────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=reflex-tech-bookkeeping-app-postgres-db
POSTGRES_USER=user
# Change this password in production environments
POSTGRES_PASSWORD=pass

# ── AI Engine (Ollama) ───────────────────────────────────────────────────────
# Use "http://host.docker.internal:11434" for local Ollama (outside Docker)
OLLAMA_HOST=ollama:11434

# ── Storage & Document Processing ─────────────────────────────────────────────
# Absolute or relative path on the host where receipts/bank statements are stored.
# The /host_fs mount in docker-compose.yml enables cross-host path resolution.
DOCUMENT_DATA_PATH=./document-data
FILE_PROCESSOR_URL=http://file-processor:8081/process
